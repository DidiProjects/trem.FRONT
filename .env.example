# Host of the self-hosted services in the catalog (the server's Tailscale IP).
# In production the CI writes it from the GitHub variable SERVICES_HOST.
VITE_SERVICES_HOST=100.64.0.1

# Optional: http (default) or https.
# VITE_SERVICES_PROTOCOL=http

# Dev server proxy target for /auth and /me. Defaults to a local trem.API on 3002.
# API_PROXY_TARGET=https://api.didilv93.com
